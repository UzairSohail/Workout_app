rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account's own data: only that account can read or write it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Splits shared between partners. The 8-letter code is the invite: anyone signed in who knows it can
    // read the split and add themselves (up to 4 people). Only members can change it, only the owner can delete it.
    // Listing is not allowed, so codes can't be browsed. Workouts and weights are never stored here.
    match /shared/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.members
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.members == resource.data.members)
        || (!(request.auth.uid in resource.data.members)
          && resource.data.members.size() < 4
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid]))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }
  }
}
